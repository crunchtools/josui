# josui-dev — Josui's development variant: a Claude Code agent that can build
#
# Same agent as the production image, same entrypoint, same mount contract
# (README.md). What it adds is a toolchain: python, uv, node, tmux, and a
# container engine, so an agent working in it can run a repo's real gates
# instead of waiting for CI to render them.
#
# WHY A DIFFERENT BASE, AND NOT `FROM josui`: a dev agent has to RUN
# containers, not only build them -- `sdlc` launches every check inside
# python-sdlc. On UBI 10 a nested `podman run` fails with "mount `proc` to
# `proc`: Operation not permitted", ruled out by measurement in
# crunchtools/gha-runner's Containerfile against crun versions, storage
# drivers, every userns/netns combination and --privileged. quay.io/podman/stable
# is the upstream project's own podman-in-podman image and does it correctly.
# The digest below is the one gha-runner already runs on gloval, so the two
# images share the host's layer cache.
#
# WHAT THIS COSTS, measured on gloval rather than assumed (2026-11-05,
# RT#1556). A container running this image needs, and needs no more than:
#
#   --device /dev/fuse
#   --cap-drop=all --cap-add=setuid,setgid,sys_chroot,chown,setfcap
#   --security-opt label=disable
#   the nested engine's storage on a volume (the root filesystem can stay
#   --read-only, with tmpfs on /tmp, /var/tmp and /run)
#
# How that set was arrived at: --cap-drop=all alone fails with "newuidmap:
# operation not permitted"; adding setuid and setgid gets past newuidmap and
# then fails unpacking a layer ("after fallback to chroot"); sys_chroot is the
# one that fixes it; chown and setfcap are kept because a layer carrying
# either needs them. That is 5 of podman's 11 default capabilities -- no
# SYS_ADMIN, no DAC_OVERRIDE, no MKNOD, not privileged. With SELinux
# enforcing the nested PULL works and the nested RUN fails with "crun: read
# from sync socket: Connection reset by peer", which is what label=disable is
# for; it is set on these containers only, and every other container on the
# host keeps its confinement.
#
# Josui Prime has none of this. That is the trade for a local inner loop, and
# it is why this is a separate image with its own Trentina profile rather than
# a flag on the production one.
#
# Build happens in GitHub Actions (.github/workflows/build-dev.yml).

FROM quay.io/podman/stable@sha256:0ccbc4e7f79f9c33e7fc959be59f714abbc0f4c9cffbe14f5bceff537a014738

LABEL maintainer="fatherlinux <scott.mccarty@crunchtools.com>"
LABEL description="josui-dev - Josui with a development toolchain and nested podman"

# The same versions the production image runs. A new Claude Code or
# claude-agent is tested on Josui Prime before it reaches a dev container:
# bump both files together, by hand.
ARG CLAUDE_CODE_VERSION=2.1.304
ARG CLAUDE_AGENT_VERSION=0.2.1

USER 0

# Anthropic's signed repository for claude-code and crunchtools' for
# claude-agent, keys imported up front (constitution XIV: repository
# definitions and keys may live in an image). The crunchtools repo sets
# repo_gpgcheck=1, so dnf needs the key in its own keyring too -- hence -y on
# every dnf below, which answers the key prompt rather than hanging on it.
RUN rpm --import https://downloads.claude.ai/keys/claude-code.asc && \
    rpm --import https://crunchtools.github.io/packages/crunchtools.asc && \
    printf '%s\n' '[claude-code]' 'name=Claude Code' \
        'baseurl=https://downloads.claude.ai/claude-code/rpm/stable' \
        'enabled=1' 'gpgcheck=1' 'gpgkey=https://downloads.claude.ai/keys/claude-code.asc' \
        > /etc/yum.repos.d/claude-code.repo && \
    curl -fsSL -o /etc/yum.repos.d/crunchtools.repo \
        https://crunchtools.github.io/packages/rpm/crunchtools.repo

# Fedora 44's python3 IS 3.14, which is what Trentina's requires-python asks
# for, so nothing here fetches a Python runtime at run time. uv and pre-commit
# come from the distribution for the same reason: a dev container's network is
# an allowlist, and every tool it has to download is another host on it.
#
# tmux is how a person reaches the live session (README, "Attaching").
# nodejs-full-i18n: without the locale data, tests that format a date pass in
# a site's own container and fail here.
RUN dnf -y install --setopt=install_weak_deps=0 \
        git-core git openssh-clients jq tar gzip findutils diffutils which \
        procps-ng hostname rsync less sqlite ripgrep tmux \
        python3 python3-devel python3-pip gcc make \
        uv pre-commit \
        nodejs nodejs-full-i18n npm \
        "claude-code-${CLAUDE_CODE_VERSION}" \
        "claude-agent-${CLAUDE_AGENT_VERSION}" "claude-agent-matrix-${CLAUDE_AGENT_VERSION}" \
        "claude-agent-trentina-${CLAUDE_AGENT_VERSION}" && \
    dnf -y clean all && \
    rm -rf /var/cache/dnf && \
    claude --version && claude-agent --version && \
    python3 -c 'import sys; assert sys.version_info[:2] >= (3, 14), sys.version' && \
    uv --version && tmux -V && podman --version

# uid 1000 is the base's own `podman` user, with the subuid ranges that make
# nesting work. It is NOT renamed to josui: that layout is the reason this
# base was chosen, and HOME follows it instead.
RUN mkdir -p /etc/josui /var/lib/josui/josui-skills /var/log/josui && \
    chown 1000:1000 /var/lib/josui /var/lib/josui/josui-skills /var/log/josui

COPY rootfs/ /

RUN chmod 0755 /usr/local/bin/josui-entrypoint && \
    bash -n /usr/local/bin/josui-entrypoint

# HOME is a volume: the Claude login, sessions, git identity and the agent's
# clones live there and survive a restart. The nested engine's storage is a
# volume of its own mounted over .local/share/containers -- it is a cache, and
# it does not belong in the state backup.
ENV HOME=/home/podman \
    JOSUI_CONFIG_DIR=/etc/josui \
    JOSUI_SKILLS_DIR=/var/lib/josui/josui-skills \
    CLAUDE_AGENT=1 \
    CLAUDE_AGENT_AUDIT_DIR=/var/log/josui \
    CLAUDE_AGENT_BREAKER_DIR=/tmp/josui-breaker \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_ERROR_REPORTING=1

USER 1000
WORKDIR /home/podman

ENTRYPOINT ["/usr/local/bin/josui-entrypoint"]
