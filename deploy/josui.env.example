# /srv/<service>/config/josui.env  (mode 0600). Placeholder values.

# The gateway, by address: this network has no DNS.
TRENTINA_MCP_URL=http://192.0.2.2:8019/gateway/agent1/mcp
TRENTINA_MCP_TOKEN=

# Claude Code's own HTTPS (inference, Remote Control, login refresh) goes out
# through the gateway's client egress. MCP and git do not. The gateway knows
# the caller by its source network; the URL carries no credential.
HTTPS_PROXY=http://192.0.2.2:8021
NO_PROXY=192.0.2.2

# git through the gateway's git route, which holds the forge token. The
# entrypoint points github.com there and has git send the gateway token.
TRENTINA_GIT_URL=http://192.0.2.2:8019/git

# Where Remote Control sessions start, and what they are called in the app.
# Not a git checkout: Remote Control registers the checkout's repository, and
# session creation fails unless the Claude GitHub App can see that repository.
# Link the workspaces under it instead.
JOSUI_WORKDIR=/home/josui/work
JOSUI_NAME=agent1
JOSUI_CAPACITY=2

# Permission mode for new sessions. acceptEdits (the default) asks the operator
# before most shell commands; an allow rule for Bash does not stop it asking
# about compound commands that leave the working directory. bypassPermissions
# asks nothing: hooks and deny rules still apply, and the container is the limit.
#JOSUI_PERMISSION_MODE=bypassPermissions

# Answer every permission question except a question to the operator and plan
# approval, whatever mode the app picks (the constitution's deviation).
#JOSUI_ANSWER_PERMISSIONS=1

# Circuit breakers (per conversation).
JOSUI_MAX_TOOL_CALLS=500
JOSUI_MAX_REPEAT=5

# The Matrix channel: an interactive session, <JOSUI_NAME>-rcs, that the
# operator's texts reach through the agent's homeserver. Unset, there is none.
#JOSUI_MATRIX_HOMESERVER=http://192.0.2.3:6167
#JOSUI_MATRIX_TOKEN_FILE=/etc/josui-matrix/token
#JOSUI_MATRIX_ALLOW=@rcs_owner:agent1.local
