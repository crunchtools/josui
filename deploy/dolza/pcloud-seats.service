[Unit]
# A live, read-only view of Scott's pCloud drive for the Dolza agent seats.
# pCloud mounts ~/pCloudDrive without allow_other, so the seats' user
# namespace cannot open it; bindfs re-exports it with allow_other (root steps:
# user_allow_other in /etc/fuse.conf, virt_use_fusefs on).
#
# ~/.pcloud-seats is a plain directory laid out like the parts of
# /home/smccarty the seats need: bindfs on pCloudDrive/, and relative symlinks
# Downloads and Pictures/Screenshots into it, as on the host. Each seat binds
# the directory at /home/smccarty with rslave, so a dragged host path resolves
# inside the seat and a bindfs restart reaches running seats without
# restarting them. The directory and symlinks carry container_file_t so the
# labelled josui container can follow them.
Description=Read-only pCloud view for the agent seats (bindfs)
StartLimitIntervalSec=0

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.pcloud-seats/pCloudDrive %h/.pcloud-seats/Pictures
ExecStartPre=/usr/bin/ln -sfn pCloudDrive/Downloads %h/.pcloud-seats/Downloads
ExecStartPre=/usr/bin/ln -sfn ../pCloudDrive/Autosync/Screenshots %h/.pcloud-seats/Pictures/Screenshots
ExecStartPre=/usr/bin/chcon -h -t container_file_t %h/.pcloud-seats %h/.pcloud-seats/pCloudDrive %h/.pcloud-seats/Pictures %h/.pcloud-seats/Downloads %h/.pcloud-seats/Pictures/Screenshots
# A crashed bindfs leaves a dead mount behind.
ExecStartPre=-/usr/bin/fusermount3 -uz %h/.pcloud-seats/pCloudDrive
# Never bind an unmounted or empty pCloud: fail, and Restart= tries again, so
# the unit waits for pCloud's own mount (which appears after Scott logs in).
ExecStartPre=/bin/sh -c 'mountpoint -q %h/pCloudDrive && test -n "$$(find %h/pCloudDrive -mindepth 1 -maxdepth 1 -print -quit)"'
ExecStart=/usr/bin/bindfs -f -r -o allow_other %h/pCloudDrive %h/.pcloud-seats/pCloudDrive
ExecStopPost=-/usr/bin/fusermount3 -uz %h/.pcloud-seats/pCloudDrive
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
