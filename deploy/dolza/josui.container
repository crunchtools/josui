[Unit]
# Secrets come from breetai's OpenBao via the runtime dir (RT#1604), not from
# a plaintext file in ~/srv. Requires= on the ONESHOT is right: no secrets,
# no start. Never Requires= on openbao itself.
Requires=srv-secrets@josui.service
After=srv-secrets@josui.service
Description=Josui Prime (dolza) - the one dispatcher, voice + Remote Control
Wants=network-online.target
After=network-online.target trentina.service

[Container]
Image=quay.io/crunchtools/developer:latest
ContainerName=josui
Pod=agents.pod
AutoUpdate=registry
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,size=1g
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=%t/srv-secrets/josui/josui.env
# The developer image, as a worker with Remote Control on (developer >= 1.7.0):
# one conversation in tmux `dev`, restarted if Claude Code exits. None of the
# nested-podman flags the Vertex workers carry, and the SELinux label stays.
# Attach: podman exec -it josui tmux attach -t dev
Environment=JOSUI_MODE=worker
Environment=JOSUI_RC=1
Environment="JOSUI_NAME=Josui Prime"
Environment=JOSUI_WORKDIR=/home/podman/work
Environment=XDG_RUNTIME_DIR=/run/agents
Volume=%h/srv/josui/config/identity:/etc/josui:ro,Z
Volume=%h/srv/josui/data/state:/home/podman:Z
Volume=%h/srv/josui/data/audit:/var/log/josui:Z
Volume=%h/srv/josui/data/josui-skills:/var/lib/josui/josui-skills:Z
# Peer discovery, shared by every member of the pod.
Volume=%h/srv/agents/sessions:/home/podman/.claude/sessions:z
Tmpfs=/run/agents:rw,nosuid,mode=1777
Volume=%h/srv/agents/run/cc-socks:/run/agents/cc-socks:z
Volume=%h/srv/agents/machine-id:/etc/machine-id:ro,z
PodmanArgs=--memory=4g --memory-swap=4g

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=180

[Install]
WantedBy=default.target
