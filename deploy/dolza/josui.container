[Unit]
Requires=srv-secrets@ssh-josui.service
After=srv-secrets@ssh-josui.service
# Secrets come from breetai's OpenBao via the runtime dir (RT#1604), not from
# a plaintext file in ~/Projects/dolza-services. Requires= on the ONESHOT is right: no secrets,
# no start. Never Requires= on openbao itself.
Requires=srv-secrets@josui.service
After=srv-secrets@josui.service
Description=Josui Prime (dolza) - the one dispatcher, voice + Remote Control
Wants=network-online.target
After=network-online.target trentina.service

[Container]
Image=quay.io/crunchtools/developer:latest
ContainerName=josui
Pod=agents.pod
AutoUpdate=registry
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,size=1g
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=%t/srv-secrets/josui/josui.env
# The developer image, as a worker with Remote Control on (developer >= 1.7.0):
# one conversation in tmux `dev`, restarted if Claude Code exits. None of the
# nested-podman flags the Vertex workers carry, and the SELinux label stays.
# Attach: podman exec -it josui tmux attach -t dev
Environment=JOSUI_MODE=worker
Environment=JOSUI_RC=1
# RCS texts (developer >= 1.8.0): with a homeserver set, the one session runs
# under claude-agent and its Matrix bridge delivers texts into it. Matrix goes
# through dolza's gateway (/matrix, profile josui-matrix, chosen by the pod's
# address) to conduit-josui on gloval, which stays beside bridge-rcs-josui.
Environment=JOSUI_MATRIX_HOMESERVER=http://trentina:8019/matrix
Environment=JOSUI_MATRIX_ALLOW=<owner's RCS puppet id, from gloval's josui.env>
Environment="JOSUI_NAME=Josui Prime"
Environment=JOSUI_WORKDIR=/home/podman/work
Environment=XDG_RUNTIME_DIR=/run/agents
Volume=%h/Projects/dolza-services/josui/config/identity:/etc/josui:ro,Z
Volume=%t/srv-secrets/josui/matrix-token:/etc/josui-matrix/token:ro,Z
Volume=%h/Projects/dolza-services/josui/data/state:/home/podman:Z
Volume=%h/Projects/dolza-services/josui/data/audit:/var/log/josui:Z
Volume=%h/Projects/dolza-services/josui/data/josui-skills:/var/lib/josui/josui-skills:Z
# Peer discovery, shared by every member of the pod.
Volume=%h/Projects/dolza-services/agents/sessions:/home/podman/.claude/sessions:z
Tmpfs=/run/agents:rw,nosuid,mode=1777
Volume=%h/Projects/dolza-services/agents/run/cc-socks:/run/agents/cc-socks:z
Volume=%h/Projects/dolza-services/agents/machine-id:/etc/machine-id:ro,z
PodmanArgs=--memory=4g --memory-swap=4g
# Its own ssh key (OpenBao kv dolza/ssh-josui) and the shared ssh config and
# known_hosts; the entrypoint copies them to tmpfs (constitution 3.0.0).
Environment=JOSUI_SSH_DIR=/etc/josui-ssh
Volume=%t/srv-secrets/ssh-josui/id_ed25519:/etc/josui-ssh/id_ed25519:ro,Z
Volume=%h/Projects/dolza-services/agents-ssh/config:/etc/josui-ssh/config:ro,z
Volume=%h/Projects/dolza-services/agents-ssh/known_hosts:/etc/josui-ssh/known_hosts:ro,z

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=180

[Install]
WantedBy=default.target
