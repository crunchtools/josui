[Unit]
Requires=srv-secrets@ssh-dmax%i.service
After=srv-secrets@ssh-dmax%i.service
# Dolza (Max) worker %i in the agents pod (2026-11-14 decision). Crunchtools
# work on Scott's Max subscription (logged in once per container: a credential
# cannot be shared). Reached by Josui Prime as a local peer, by Scott over
# Remote Control, and with: podman exec -it dmax%i tmux attach -t dev
# Its gateway token (Trentina profile `developer`) comes from OpenBao
# (kv dolza/dmax/dmax.env) through the srv-secrets@dmax oneshot.
Requires=srv-secrets@dmax.service
After=srv-secrets@dmax.service josui.service
Description=Dolza (Max) worker %i (agents pod)

[Container]
Image=quay.io/crunchtools/claude:latest
ContainerName=dmax%i
Pod=agents.pod
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,size=2g
# Nested podman, as measured for the developer seats (developer README).
DropCapability=all
AddCapability=setuid setgid sys_chroot chown setfcap
SecurityLabelDisable=true
Unmask=/proc/*
AddDevice=/dev/fuse
EnvironmentFile=%t/srv-secrets/dmax/dmax.env
Environment=JOSUI_MAX_TOOL_CALLS=500
Environment=JOSUI_MAX_REPEAT=5
Environment=JOSUI_ANSWER_PERMISSIONS=1
Environment=JOSUI_MODE=worker
Environment=JOSUI_RC=1
Environment="JOSUI_NAME=Dolza %i - Max"
Environment=JOSUI_WORKDIR=/home/podman/work
# Gloval's git route: clone and push crunchtools repos through the gateway.
Environment=TRENTINA_GIT_URL=https://trentina.crunchtools.com/proxy/git
Environment=JOSUI_PERMISSION_MODE=bypassPermissions
Environment=XDG_RUNTIME_DIR=/run/agents
Volume=%h/Projects/dolza-services/agents/developer-identity:/etc/josui:ro
Volume=%h/Projects/dolza-services/josui/data/josui-skills:/var/lib/josui/josui-skills:ro
Volume=%h/Projects/dolza-services/dmax%i/data/state:/home/podman
Volume=%h/Projects/dolza-services/dmax%i/data/containers:/home/podman/.local/share/containers
Volume=%h/Projects/dolza-services/dmax%i/data/audit:/var/log/josui
# The work tree lives under ~/Projects so it is backed up with the rest.
Volume=%h/Projects/dolza-max%i:/home/podman/work
Volume=%h/Projects/dolza-services/agents/sessions:/home/podman/.claude/sessions
Tmpfs=/run/agents:rw,nosuid,mode=1777
Volume=%h/Projects/dolza-services/agents/run/cc-socks:/run/agents/cc-socks
Volume=%h/Projects/dolza-services/agents/machine-id:/etc/machine-id:ro
PodmanArgs=--memory=4g --memory-swap=4g
# Its own ssh key (OpenBao kv dolza/ssh-dmax%i) and the shared ssh config and
# known_hosts; the entrypoint copies them to tmpfs (constitution 3.0.0).
Environment=JOSUI_SSH_DIR=/etc/josui-ssh
Volume=%t/srv-secrets/ssh-dmax%i/id_ed25519:/etc/josui-ssh/id_ed25519:ro
Volume=%h/Projects/dolza-services/agents-ssh/config:/etc/josui-ssh/config:ro
Volume=%h/Projects/dolza-services/agents-ssh/known_hosts:/etc/josui-ssh/known_hosts:ro

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=180

[Install]
WantedBy=default.target
