{
  "allowedMcpServers": [
    {
      "serverName": "trentina"
    }
  ],
  "disableClaudeAiConnectors": true,
  "allowManagedHooksOnly": true,
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/josui/hooks.py breaker",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/josui/deny-local-memory.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/josui/allow-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/josui/hooks.py audit",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/josui/allow-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
