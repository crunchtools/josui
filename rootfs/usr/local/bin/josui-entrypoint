#!/bin/bash
# Assemble Josui's Claude Code home from what was mounted, then serve Remote
# Control. Anything given as arguments runs instead, with the same home:
#   podman run -it ... quay.io/crunchtools/josui claude auth login
set -euo pipefail

config_dir=${JOSUI_CONFIG_DIR:?JOSUI_CONFIG_DIR is not set}
skills_repo=${JOSUI_SKILLS_DIR:?JOSUI_SKILLS_DIR is not set}
claude_dir="$HOME/.claude"
workdir=${JOSUI_WORKDIR:-$HOME/work}

log() { echo "josui: $*" >&2; }

# josui.env keeps the names it has always had; claude-agent reads its own.
for name in ANSWER_PERMISSIONS MAX_TOOL_CALLS MAX_REPEAT; do
  value="JOSUI_$name"
  if [ -n "${!value:-}" ]; then
    export "CLAUDE_AGENT_$name=${!value}"
  fi
done

mkdir -p "$claude_dir/skills" "$claude_dir/hooks" "$workdir"

# Identity is copied in, not linked: the mount is read-only and Claude Code
# rewrites its own settings file. The mounted copy wins again at next start.
for name in CLAUDE.md settings.json; do
  if [ -f "$config_dir/$name" ]; then
    install -m 0644 "$config_dir/$name" "$claude_dir/$name"
  else
    log "no $name in $config_dir"
  fi
done
# Only the image's managed hooks run (allowManagedHooksOnly), so a hook in
# this home, written by the agent or planted by a checkout, does nothing.
# Clear the old copies so nobody mistakes them for live ones.
find "$claude_dir/hooks" -mindepth 1 -delete
if [ -d "$config_dir/hooks" ]; then
  log "$config_dir/hooks is ignored: only the image's managed hooks run"
fi

# git reaches GitHub through the gateway's git route, which holds the GitHub
# token. Set up before the skills pull below, which goes the same way. git sends the gateway token, written to a file in the state volume
# like the state file above, so it is not handed to Claude Code in the
# environment. The global git config includes that file.
git_url=${TRENTINA_GIT_URL:-}
git_url=${git_url%/}
# It is written into git config syntax, so only a plain URL is accepted.
if [ -n "$git_url" ] && ! [[ "$git_url" =~ ^https?://[A-Za-z0-9.:-]+(/[A-Za-z0-9._-]+)*$ ]]; then
  log "TRENTINA_GIT_URL is not a plain http(s) URL, ignoring it"
  git_url=
fi
if [ -n "$git_url" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  gitconf="$HOME/.config/josui/gateway.gitconfig"
  mkdir -p "$(dirname "$gitconf")"
  # printf is a builtin, so the token is never in a process's arguments.
  (
    umask 077
    rm -f "$gitconf"
    printf '[http "%s/"]\n\textraHeader = Authorization: Bearer %s\n[url "%s/github/"]\n\tinsteadOf = https://github.com/\n' \
      "$git_url" "$TRENTINA_MCP_TOKEN" "$git_url" > "$gitconf"
  )
  git config --global --get-all include.path | grep -qxF "$gitconf" ||
    git config --global --add include.path "$gitconf"
fi
# Skills are a git checkout on a volume. A failed pull is not fatal: the
# checkout that is there still works, and the network may be the thing down.
if [ -d "$skills_repo/.git" ]; then
  git -C "$skills_repo" pull --ff-only --quiet || log "skills pull failed, using the checkout as it is"
fi
find "$claude_dir/skills" -mindepth 1 -maxdepth 1 -type l -delete
if [ -d "$skills_repo/skills" ]; then
  for skill in "$skills_repo"/skills/*/; do
    ln -s "${skill%/}" "$claude_dir/skills/$(basename "$skill")"
  done
fi
if [ -d "$skills_repo/templates" ]; then
  ln -sfn "$skills_repo/templates" "$claude_dir/templates"
fi

# The gateway is the one MCP server. Its address and token come from the
# environment and are merged into the state file Claude Code reads, keeping
# whatever else Claude Code has stored there.
if [ -n "${TRENTINA_MCP_URL:-}" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  state="$HOME/.claude.json"
  [ -s "$state" ] || echo '{}' > "$state"
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  jq --arg url "$TRENTINA_MCP_URL" --arg auth "Bearer $TRENTINA_MCP_TOKEN" \
    '.mcpServers = {trentina: {type: "http", url: $url, headers: {Authorization: $auth}}}' \
    "$state" > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$state"
else
  log "TRENTINA_MCP_URL / TRENTINA_MCP_TOKEN not set, starting without a gateway"
fi

unset TRENTINA_MCP_TOKEN

# The text session, when a homeserver is configured: claude-agent run holds an
# interactive session and starts its Matrix bridge beside it. The bridge keeps
# the sync position the old channel kept, so texts sent across the upgrade
# arrive. The session is interactive, so onboarding is recorded as done; the
# working directory's trust question is left to the operator (see README).
# Audit files are pruned by claude-agent's audit hook itself.
session=
if [ -n "${JOSUI_MATRIX_HOMESERVER:-}" ]; then
  export CLAUDE_AGENT_MATRIX_HOMESERVER=$JOSUI_MATRIX_HOMESERVER
  export CLAUDE_AGENT_MATRIX_TOKEN_FILE=${JOSUI_MATRIX_TOKEN_FILE:-/etc/josui-matrix/token}
  export CLAUDE_AGENT_MATRIX_ALLOW=${JOSUI_MATRIX_ALLOW:-}
  export CLAUDE_AGENT_MATRIX_STATE=$HOME/.config/josui/matrix-sync
  state="$HOME/.claude.json"
  [ -s "$state" ] || echo '{}' > "$state"
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  jq '.hasCompletedOnboarding = true' "$state" > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$state"
  session=1
fi

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

# A proxy endpoint as /proc/net/tcp writes it: the address little-endian, the
# port big-endian. "http://10.89.13.2:8021" becomes "020D590A:1F55".
proxy_endpoint_hex() {
  local url=$1 host port a b c d
  url=${url#*://}
  url=${url%%/*}
  host=${url%%:*}
  port=${url##*:}
  [ "$port" != "$host" ] || port=80
  # The port is checked first: a successful match clears BASH_REMATCH, so the
  # address has to be the last pattern tested before its groups are read.
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  [[ "$host" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]} c=${BASH_REMATCH[3]} d=${BASH_REMATCH[4]}
  printf '%02X%02X%02X%02X:%04X' "$d" "$c" "$b" "$a" "$port"
}

# How many ESTABLISHED connections there are to that endpoint.
egress_connections() {
  local net_tcp=${JOSUI_NET_TCP:-/proc/net/tcp}
  [ -r "$net_tcp" ] || { echo 0; return; }
  awk -v target="$1" 'NR > 1 && $3 == target && $4 == "01" { n++ } END { print n + 0 }' "$net_tcp"
}

# Remote Control can keep running with no connection at all. It happened on
# 2026-11-05: the gateway restarted, the client never came back, and the
# container looked healthy for nineteen hours because the process was alive,
# its stdout goes to /dev/null and Restart=always only fires when something
# exits. So: if nothing is connected to the client egress for the grace
# period, end the container and let the unit start it again.
egress_watchdog() {
  local target=$1 grace=${JOSUI_WATCHDOG_GRACE:-300} interval=${JOSUI_WATCHDOG_INTERVAL:-60}
  local down=0 max_bytes=${JOSUI_DEBUG_MAX_BYTES:-67108864}
  while sleep "$interval"; do
    # The debug file below is the only thing here that grows without bound.
    if [ -n "$debug_file" ] && [ "$(stat -c %s "$debug_file" 2>/dev/null || echo 0)" -gt "$max_bytes" ]; then
      : > "$debug_file"
      log "truncated $debug_file at $max_bytes bytes"
    fi
    if [ "$(egress_connections "$target")" -gt 0 ]; then
      down=0
      continue
    fi
    down=$((down + interval))
    if [ "$down" -ge "$grace" ]; then
      log "nothing connected to the client egress for ${down}s: Remote Control is not connected, stopping so the unit restarts it"
      return 1
    fi
    log "nothing connected to the client egress (${down}s of ${grace}s grace)"
  done
}

# A person's own terminal inside the container, for a copy that is worked in
# rather than only texted and driven from the app:
#
#   podman exec -it <service> tmux attach -t dev
#
# tmux rather than `claude-agent attach --rw`, which renders the supervised
# session at the fixed size the supervisor set rather than the attaching
# terminal's. Deliberately NOT in the pid list below: someone exiting their
# own shell must not take the container down with it.
start_tmux_session() {
  local tmux=${JOSUI_TMUX_CMD:-tmux}
  if ! command -v "$tmux" > /dev/null 2>&1; then
    log "JOSUI_TMUX is set but there is no $tmux in this image"
    return
  fi
  if "$tmux" has-session -t dev 2>/dev/null; then
    return
  fi
  "$tmux" new-session -d -s dev -c "$workdir" \
    claude --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}"
  # Quitting Claude Code leaves the pane to be respawned (prefix + :respawn-pane)
  # instead of ending the session and losing the window layout with it.
  "$tmux" set-option -t dev remain-on-exit on 2>/dev/null || true
  "$tmux" new-window -d -t dev -c "$workdir" 2>/dev/null || true
  log "tmux session 'dev' is up: podman exec -it <service> tmux attach -t dev"
}

cd "$workdir"
# Remote Control redraws a terminal status screen on stdout every second.
# Under a container runtime that is a line a second into the journal, so
# stdout is dropped; errors still go to stderr.
# Telemetry is off for both Claude processes.
export DISABLE_TELEMETRY=1
server_args=(
  remote-control
  --spawn same-dir
  --capacity "${JOSUI_CAPACITY:-2}"
  --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}"
)
# Session creation can fail in a way nothing else reports: on 2026-10-11 a
# workdir that was a git checkout made Anthropic refuse every session with an
# HTTP 400, and the only trace was in this file. It is truncated at each start
# and capped by the watchdog above.
debug_file=${JOSUI_DEBUG_FILE:-}
if [ -z "$debug_file" ] && [ -n "${CLAUDE_AGENT_AUDIT_DIR:-}" ] && [ -d "${CLAUDE_AGENT_AUDIT_DIR:-}" ]; then
  debug_file="$CLAUDE_AGENT_AUDIT_DIR/remote-control.log"
fi
if [ -n "$debug_file" ] && : > "$debug_file" 2>/dev/null; then
  server_args+=(--debug-file "$debug_file")
else
  [ -z "$debug_file" ] || log "cannot write $debug_file, running without a debug file"
  debug_file=
fi
server_args+=(--remote-control-session-name-prefix "${JOSUI_NAME:-josui}")

# The Remote Control server, the watchdog, and -- when a homeserver is
# configured -- claude-agent, side by side. When any of them ends the
# container ends, and the unit restarts all of it.
pids=()
claude "${server_args[@]}" > /dev/null &
pids+=($!)
if [ -n "${HTTPS_PROXY:-}" ] && egress_target=$(proxy_endpoint_hex "$HTTPS_PROXY"); then
  egress_watchdog "$egress_target" &
  pids+=($!)
elif [ -n "${HTTPS_PROXY:-}" ]; then
  log "HTTPS_PROXY is not a plain address, running without the egress watchdog"
fi
if [ -n "$session" ]; then
  claude-agent run -- --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}" &
  pids+=($!)
fi
if [ -n "${JOSUI_TMUX:-}" ]; then
  start_tmux_session
fi
trap 'kill "${pids[@]}" 2>/dev/null' TERM INT
status=0
wait -n "${pids[@]}" || status=$?
log "a supervised process ended (status $status), stopping"
kill "${pids[@]}" 2>/dev/null || true
wait || true
exit "$status"
