#!/bin/bash
# Assemble Josui's Claude Code home from what was mounted, then serve Remote
# Control. Anything given as arguments runs instead, with the same home:
#   podman run -it ... quay.io/crunchtools/josui claude auth login
set -euo pipefail

config_dir=${JOSUI_CONFIG_DIR:?JOSUI_CONFIG_DIR is not set}
skills_repo=${JOSUI_SKILLS_DIR:?JOSUI_SKILLS_DIR is not set}
claude_dir="$HOME/.claude"
workdir=${JOSUI_WORKDIR:-$HOME/work}

log() { echo "josui: $*" >&2; }

# josui.env keeps the names it has always had; claude-agent reads its own.
for name in ANSWER_PERMISSIONS MAX_TOOL_CALLS MAX_REPEAT; do
  value="JOSUI_$name"
  if [ -n "${!value:-}" ]; then
    export "CLAUDE_AGENT_$name=${!value}"
  fi
done

mkdir -p "$claude_dir/skills" "$claude_dir/hooks" "$workdir"

# Identity is copied in, not linked: the mount is read-only and Claude Code
# rewrites its own settings file. The mounted copy wins again at next start.
for name in CLAUDE.md settings.json; do
  if [ -f "$config_dir/$name" ]; then
    install -m 0644 "$config_dir/$name" "$claude_dir/$name"
  else
    log "no $name in $config_dir"
  fi
done
# Only the image's managed hooks run (allowManagedHooksOnly), so a hook in
# this home, written by the agent or planted by a checkout, does nothing.
# Clear the old copies so nobody mistakes them for live ones.
find "$claude_dir/hooks" -mindepth 1 -delete
if [ -d "$config_dir/hooks" ]; then
  log "$config_dir/hooks is ignored: only the image's managed hooks run"
fi

# git reaches GitHub through the gateway's git route, which holds the GitHub
# token. Set up before the skills pull below, which goes the same way. git sends the gateway token, written to a file in the state volume
# like the state file above, so it is not handed to Claude Code in the
# environment. The global git config includes that file.
git_url=${TRENTINA_GIT_URL:-}
git_url=${git_url%/}
# It is written into git config syntax, so only a plain URL is accepted.
if [ -n "$git_url" ] && ! [[ "$git_url" =~ ^https?://[A-Za-z0-9.:-]+(/[A-Za-z0-9._-]+)*$ ]]; then
  log "TRENTINA_GIT_URL is not a plain http(s) URL, ignoring it"
  git_url=
fi
if [ -n "$git_url" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  gitconf="$HOME/.config/josui/gateway.gitconfig"
  mkdir -p "$(dirname "$gitconf")"
  # printf is a builtin, so the token is never in a process's arguments.
  (
    umask 077
    rm -f "$gitconf"
    printf '[http "%s/"]\n\textraHeader = Authorization: Bearer %s\n[url "%s/github/"]\n\tinsteadOf = https://github.com/\n' \
      "$git_url" "$TRENTINA_MCP_TOKEN" "$git_url" > "$gitconf"
  )
  git config --global --get-all include.path | grep -qxF "$gitconf" ||
    git config --global --add include.path "$gitconf"
fi
# Skills are a git checkout on a volume. A failed pull is not fatal: the
# checkout that is there still works, and the network may be the thing down.
if [ -d "$skills_repo/.git" ]; then
  git -C "$skills_repo" pull --ff-only --quiet || log "skills pull failed, using the checkout as it is"
fi
find "$claude_dir/skills" -mindepth 1 -maxdepth 1 -type l -delete
if [ -d "$skills_repo/skills" ]; then
  for skill in "$skills_repo"/skills/*/; do
    ln -s "${skill%/}" "$claude_dir/skills/$(basename "$skill")"
  done
fi
if [ -d "$skills_repo/templates" ]; then
  ln -sfn "$skills_repo/templates" "$claude_dir/templates"
fi

# The gateway is the one MCP server. Its address and token come from the
# environment and are merged into the state file Claude Code reads, keeping
# whatever else Claude Code has stored there.
if [ -n "${TRENTINA_MCP_URL:-}" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  state="$HOME/.claude.json"
  [ -s "$state" ] || echo '{}' > "$state"
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  jq --arg url "$TRENTINA_MCP_URL" --arg auth "Bearer $TRENTINA_MCP_TOKEN" \
    '.mcpServers = {trentina: {type: "http", url: $url, headers: {Authorization: $auth}}}' \
    "$state" > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$state"
else
  log "TRENTINA_MCP_URL / TRENTINA_MCP_TOKEN not set, starting without a gateway"
fi

unset TRENTINA_MCP_TOKEN

# The text session, when a homeserver is configured: claude-agent run holds an
# interactive session and starts its Matrix bridge beside it. The bridge keeps
# the sync position the old channel kept, so texts sent across the upgrade
# arrive. The session is interactive, so onboarding is recorded as done; the
# working directory's trust question is left to the operator (see README).
# Audit files are pruned by claude-agent's audit hook itself.
session=
if [ -n "${JOSUI_MATRIX_HOMESERVER:-}" ]; then
  export CLAUDE_AGENT_MATRIX_HOMESERVER=$JOSUI_MATRIX_HOMESERVER
  export CLAUDE_AGENT_MATRIX_TOKEN_FILE=${JOSUI_MATRIX_TOKEN_FILE:-/etc/josui-matrix/token}
  export CLAUDE_AGENT_MATRIX_ALLOW=${JOSUI_MATRIX_ALLOW:-}
  export CLAUDE_AGENT_MATRIX_STATE=$HOME/.config/josui/matrix-sync
  state="$HOME/.claude.json"
  [ -s "$state" ] || echo '{}' > "$state"
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  jq '.hasCompletedOnboarding = true' "$state" > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$state"
  session=1
fi

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

cd "$workdir"
# Remote Control redraws a terminal status screen on stdout every second.
# Under a container runtime that is a line a second into the journal, so
# stdout is dropped; errors still go to stderr.
# Telemetry is off for both Claude processes.
export DISABLE_TELEMETRY=1
server_args=(
  remote-control
  --spawn same-dir
  --capacity "${JOSUI_CAPACITY:-2}"
  --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}"
  --remote-control-session-name-prefix "${JOSUI_NAME:-josui}"
)
if [ -z "$session" ]; then
  exec claude "${server_args[@]}" > /dev/null
fi

# With the text session, the Remote Control server and claude-agent run side
# by side. When either ends the container ends, and the unit restarts both.
claude "${server_args[@]}" > /dev/null &
server=$!
claude-agent run -- --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}" &
session=$!
trap 'kill "$server" "$session" 2>/dev/null' TERM INT
status=0
wait -n "$server" "$session" || status=$?
log "a claude process ended (status $status), stopping"
kill "$server" "$session" 2>/dev/null || true
wait || true
exit "$status"
