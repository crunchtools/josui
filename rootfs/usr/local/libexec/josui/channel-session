#!/usr/bin/expect -f
# Run the channel session: an interactive Claude Code session with Remote
# Control on and the Matrix channel loaded. Claude Code loads a channel only
# in an interactive session, and a channel that is not on Anthropic's
# allowlist only with --dangerously-load-development-channels, whose warning
# has to be answered at every start. This gives the session its terminal
# and answers that warning, plus the two dialogs a fresh home can show.
#
#   channel-session <mcp-config> <session-name> <permission-mode>
#
# The TUI draws the gaps between words as cursor moves, so the patterns are
# single words. Each dialog is answered once. Exits with Claude's status.

if {[llength $argv] != 3} {
    puts stderr "usage: channel-session <mcp-config> <session-name> <permission-mode>"
    exit 2
}
lassign $argv config name mode

proc note {message} { puts stderr "channel-session: $message" }

log_user 0
set stty_init "rows 50 columns 160"
spawn -noecho claude --mcp-config $config --remote-control $name --permission-mode $mode \
    --dangerously-load-development-channels server:matrix

set down "\033\[B"
set answered {}
set timeout 60
expect {
    -re {inject} {
        # "Channels (experimental) messages from server:matrix inject
        # directly in this session": the channel is registered.
        note "channel registered, session $name is live"
    }
    -re {development} {
        # Option 1, "I am using this for local development", is the default.
        if {"channels" ni $answered} {
            sleep 1
            send "\r"
            lappend answered channels
            note "answered the development channels warning"
        }
        exp_continue
    }
    -re {folder} {
        # The trust question; its default is "No, exit".
        if {"trust" ni $answered} {
            sleep 1
            send $down
            sleep 0.5
            send "\r"
            lappend answered trust
            note "trusted the working directory"
        }
        exp_continue
    }
    -re {Bypass} {
        # The bypass permissions warning; its default is "No, exit".
        if {$mode eq "bypassPermissions" && "bypass" ni $answered} {
            sleep 1
            send $down
            sleep 0.5
            send "\r"
            lappend answered bypass
            note "accepted bypass permissions mode"
        }
        exp_continue
    }
    timeout {
        note "no channel after 60s; a dialog this script does not know may be waiting"
        exp_continue
    }
    eof {
        note "claude exited before the channel was registered"
        catch wait status
        exit [expr {[lindex $status 3] ? [lindex $status 3] : 1}]
    }
}

set timeout -1
expect eof
catch wait status
set code [lindex $status 3]
note "claude exited with status $code"
exit $code
